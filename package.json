{
  "name": "solar_system",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.20.0" },
  "description": "Атлас Солнечной системы: интерактивная 3D-модель планет и спутников на Three.js",
  "main": "index.js",
  "scripts": {
    "assets": "node scripts/prepare-textures.mjs",
    "assets:download-moons": "node --use-system-ca scripts/download-moon-textures.mjs",
    "orbits:update-moons": "node --use-system-ca scripts/update-moon-orbits.mjs",
    "prebuild": "npm run assets && npm run typecheck && npm test",
    "build": "vite build",
    "prestart": "npm run assets",
    "start": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwow777/solar_system.git"
  },
  "author": "Aleksandr Raspertov",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jwow777/solar_system/issues"
  },
  "homepage": "https://github.com/jwow777/solar_system#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.184.0",
    "autoprefixer": "^10.5.0",
    "cssnano": "^7.1.5",
    "gh-pages": "^6.3.0",
    "npm-check-updates": "^21.0.2",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  }
}
